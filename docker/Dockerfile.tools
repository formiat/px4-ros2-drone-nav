# The tool image of roadmap item 25 (the technical debt's reference
# estimators): the reference estimators beside ours, offline, never in flight.
# OpenVINS (rpng/open_vins, ROS-free, installed under /usr/local, the commit in
# /opt/openvins_commit) and FAST-LIO (hku-mars/FAST_LIO, the ROS2 branch, with
# the Livox driver it requires, the commit in /opt/fastlio_commit) on ROS 2
# Jazzy. Built by tools/tools_image.sh; nothing of it reaches the flight image.
FROM ros:jazzy-ros-base AS openvins
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git ca-certificates pkg-config \
      libeigen3-dev libboost-all-dev libceres-dev libopencv-dev libpcl-dev \
      python3-colcon-common-extensions python3-numpy python3-dev \
      ros-jazzy-pcl-ros ros-jazzy-pcl-conversions ros-jazzy-rosbag2 \
      ros-jazzy-rosbag2-storage-mcap ros-jazzy-tf2-ros ros-jazzy-nav-msgs \
      ros-jazzy-visualization-msgs ros-jazzy-std-srvs \
    && rm -rf /var/lib/apt/lists/*
# OpenVINS, ROS-free: ov_msckf with ov_core and ov_init, installed as a library.
RUN git clone --depth 1 https://github.com/rpng/open_vins /opt/open_vins \
    && cd /opt/open_vins && git rev-parse HEAD > /opt/openvins_commit \
    && cd ov_msckf && mkdir build && cd build \
    && cmake -DENABLE_ROS=OFF -DENABLE_ARUCO_TAGS=OFF -DCMAKE_BUILD_TYPE=Release .. \
    && make -j"$(nproc)" && make install && ldconfig
# The Livox SDK and driver (FAST-LIO's ROS2 branch requires the driver's messages).
FROM openvins AS tools
RUN git clone --depth 1 https://github.com/Livox-SDK/Livox-SDK2 /opt/Livox-SDK2 \
    && cd /opt/Livox-SDK2 && mkdir build && cd build && cmake -DCMAKE_BUILD_TYPE=Release .. \
    && make -j"$(nproc)" && make install && ldconfig
RUN mkdir -p /opt/fast_lio_ws/src && cd /opt/fast_lio_ws/src \
    && git clone --depth 1 https://github.com/Livox-SDK/livox_ros_driver2 \
    && cp livox_ros_driver2/package_ROS2.xml livox_ros_driver2/package.xml \
    && git clone --depth 1 -b ROS2 --recursive https://github.com/hku-mars/FAST_LIO \
    && (cd FAST_LIO && git rev-parse HEAD > /opt/fastlio_commit \
        && sed -i 's/CMAKE_CXX_STANDARD 14/CMAKE_CXX_STANDARD 17/g; s/-std=c++14/-std=c++17/g' CMakeLists.txt) \
    && cd /opt/fast_lio_ws \
    && bash -c "source /opt/ros/jazzy/setup.bash && colcon build --event-handlers console_direct- \
         --cmake-args -DROS_EDITION=ROS2 -DDISTRO_ROS=jazzy -DCMAKE_BUILD_TYPE=Release"
RUN echo 'source /opt/ros/jazzy/setup.bash; source /opt/fast_lio_ws/install/setup.bash' > /etc/profile.d/tools.sh
