Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: gazebo_map
    - Alpha: 0.75
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: false
      Enabled: false
      Name: Raw Obstacle Grid
      Topic:
        Value: /drone_city_nav/raw_obstacle_grid
    - Alpha: 0.45
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: false
      Name: Static City Map
      Topic:
        Value: /drone_city_nav/static_map_grid
    - Alpha: 0.12
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 72; 220; 112
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Name: Static City Map Points
      Position Transformer: XYZ
      Size (Pixels): 5
      Size (m): 1.5
      Style: Squares
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone_city_nav/static_map_points
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Static Building Volumes
      Namespaces:
        static_building: true
      Topic:
        Value: /drone_city_nav/static_building_markers
    - Alpha: 0.72
      Class: rviz_default_plugins/Path
      Color: 38; 191; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.08
      Name: Interceptor 0 Route
      Topic:
        Value: /vehicles/interceptor_0/mppi/path
    - Alpha: 0.72
      Class: rviz_default_plugins/Path
      Color: 76; 235; 115
      Enabled: true
      Line Style: Lines
      Line Width: 0.08
      Name: Interceptor 1 Route
      Topic:
        Value: /vehicles/interceptor_1/mppi/path
    - Alpha: 0.72
      Class: rviz_default_plugins/Path
      Color: 255; 153; 51
      Enabled: true
      Line Style: Lines
      Line Width: 0.08
      Name: Interceptor 2 Route
      Topic:
        Value: /vehicles/interceptor_2/mppi/path
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Interceptor Directions
      Topic:
        Value: /drone_city_nav/interceptor_directions
    - Alpha: 1
      Class: rviz_default_plugins/Path
      Color: 0; 220; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.18
      Name: Selected MPPI Candidate Horizon
      Topic:
        Value: /drone_city_nav/mppi/path
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Selected MPPI Markers
      Namespaces:
        global_lattice_guide: true
        mppi_candidate: true
        mppi_execution: true
        mppi_target: true
        mission_goal: true
        mission_start: true
      Topic:
        Value: /drone_city_nav/mppi/markers
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Drone
      Namespaces:
        drone: true
      Topic:
        Value: /drone_city_nav/drone_marker
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 64; 64
      Color Transformer: FlatColor
      Decay Time: 2
      Enabled: true
      Name: Lidar Hit Points
      Position Transformer: XYZ
      Size (Pixels): 5
      Size (m): 0.35
      Style: Spheres
      Topic:
        Value: /drone_city_nav/lidar_debug_points
    - Alpha: 0.95
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 60; 220; 220
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Raw Lidar Returns 3D
      Position Transformer: XYZ
      Size (Pixels): 4
      Size (m): 0.20
      Style: Spheres
      Topic:
        Value: /drone_city_nav/raw_lidar_hit_points_3d
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 218; 75
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Remembered Lidar Hits
      Position Transformer: XYZ
      Size (Pixels): 4
      Size (m): 0.25
      Style: Spheres
      Topic:
        Value: /drone_city_nav/remembered_lidar_points
    - Alpha: 0.85
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 235; 235; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Raw Memory Cells
      Position Transformer: XYZ
      Size (Pixels): 3
      Size (m): 0.22
      Style: Spheres
      Topic:
        Value: /drone_city_nav/raw_memory_obstacle_points
    - Alpha: 0.95
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 135; 190
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Raw Memory Hit Origins 3D
      Position Transformer: XYZ
      Size (Pixels): 4
      Size (m): 0.25
      Style: Spheres
      Topic:
        Value: /drone_city_nav/raw_memory_obstacle_points_3d
    - Alpha: 0.75
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 38; 191; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Name: Interceptor 0 Memory (Optional)
      Position Transformer: XYZ
      Size (Pixels): 3
      Size (m): 0.25
      Style: Spheres
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vehicles/interceptor_0/raw_memory_points_3d
    - Alpha: 0.75
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 76; 235; 115
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Name: Interceptor 1 Memory (Optional)
      Position Transformer: XYZ
      Size (Pixels): 3
      Size (m): 0.25
      Style: Spheres
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vehicles/interceptor_1/raw_memory_points_3d
    - Alpha: 0.75
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 153; 51
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Name: Interceptor 2 Memory (Optional)
      Position Transformer: XYZ
      Size (Pixels): 3
      Size (m): 0.25
      Style: Spheres
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vehicles/interceptor_2/raw_memory_points_3d
    - Alpha: 0.30
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 180; 110; 28
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Raw Occupied Cells
      Position Transformer: XYZ
      Size (Pixels): 2
      Size (m): 0.35
      Style: Flat Squares
      Topic:
        Value: /drone_city_nav/raw_occupied_cells
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 3
      Name: Map Axes
      Radius: 0.08
  Enabled: true
  Global Options:
    Background Color: 20; 24; 28
    Fixed Frame: gazebo_map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 170
      Focal Point:
        X: 45
        Y: 75
        Z: 0
      Name: Top Down Gazebo Aligned
      Pitch: 1.5707
      Target Frame: gazebo_map
      Yaw: 0
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
