<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="stereo_tof_v1">
    <!-- The sensor set of roadmap item 14. The pair sits on a nose mount ahead
         of the rotor discs (they reach x = 0.30 m), so no rotor is in a 120 degree
         view; 1280 x 960, 120 degrees, a 0.20 m baseline, 7.5 Hz (a pair takes
         about 110 ms to match, and at 15 Hz the simulator, the image bridge and
         the matcher together left the workstation no core: r479), RGB (an L8
         image is converted on the CPU in the render thread and held the
         simulation at a real-time factor of 0.39; RGB runs at 0.99). The two
         time-of-flight sensors are VL53L8 class: 8 x 8 zones whose centres span
         45 degrees less one zone, 2.8 m, the published range in 5 000 lux, at the pair's
         7.5 Hz so that the three sensors fire on one simulation step;
         the zone centres are the rays, the adapter gives each its cone. -->
    <link name="stereo_tof_link">
      <pose>0.32 0 0.02 0 0 0</pose>
      <inertial>
        <mass>0.000001</mass>
        <inertia>
          <ixx>0.000000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000000001</iyy>
          <iyz>0</iyz>
          <izz>0.000000001</izz>
        </inertia>
      </inertial>
      <!-- Roadmap item 17 stage 3: the light the vehicle carries, a flood over
           the pair's field and not a beam (stereo matches the whole overlap).
           Illuminance falls with the square of the distance: the attenuation
           keeps a near constant term and a quadratic one, so the pair sees
           by it well inside four metres and ever less beyond. It is lit in
           every world; in the dark one it is the only light. -->
      <light name="carried_light" type="spot">
        <pose>0.02 0 0 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <diffuse>1 1 1 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
        <!-- Over the pair's whole field, an intensity of 8 saturated the
             frames at the lowest gain and flew 1.58 m/s (r770); 2 flew 1.88
             m/s at the full measured range (r771); 0.5 flew 1.38 m/s with
             the range down to 2.6 m in places (r772). -->
        <intensity>2</intensity>
        <direction>1 0 0</direction>
        <attenuation>
          <range>25</range>
          <constant>0.25</constant>
          <linear>0</linear>
          <quadratic>0.06</quadratic>
        </attenuation>
        <!-- The angles are the cones' full angles. The inner cone spans the
             pair's 120 degree width and the outer one its 130 degree
             diagonal: the braking contract answers for motion up to 60
             degrees off the axis by what the pair sees, and a cone of 1.3
             rad left 23 degrees of each side of that unlit (r769). -->
        <spot>
          <inner_angle>2.1</inner_angle>
          <outer_angle>2.4</outer_angle>
          <falloff>1.0</falloff>
        </spot>
      </light>
      <sensor name="stereo_left" type="camera">
        <gz_frame_id>stereo_tof_link</gz_frame_id>
        <pose>0 0.10 0 0 0 0</pose>
        <camera>
          <horizontal_fov>2.0943951023931953</horizontal_fov>
          <image>
            <width>1280</width>
            <height>960</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>60</far>
          </clip>
          <!-- Everything but the vehicle's own GUI markers and the grey
               collision proxies the lidar reads: the pair sees the world's
               real surfaces only. -->
          <visibility_mask>218103807</visibility_mask>
          <!-- Roadmap item 17 stage 1: read noise that does not fall with
               the light, so that the matcher degrades with the signal the
               way a real imager does in the dark (about 2.5 of 255 levels,
               a small CMOS sensor's read noise). -->
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </camera>
        <always_on>true</always_on>
        <update_rate>7.5</update_rate>
        <visualize>false</visualize>
      </sensor>
      <sensor name="stereo_right" type="camera">
        <gz_frame_id>stereo_tof_link</gz_frame_id>
        <pose>0 -0.10 0 0 0 0</pose>
        <camera>
          <horizontal_fov>2.0943951023931953</horizontal_fov>
          <image>
            <width>1280</width>
            <height>960</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>60</far>
          </clip>
          <!-- Everything but the vehicle's own GUI markers and the grey
               collision proxies the lidar reads: the pair sees the world's
               real surfaces only. -->
          <visibility_mask>218103807</visibility_mask>
          <!-- Roadmap item 17 stage 1: read noise that does not fall with
               the light, so that the matcher degrades with the signal the
               way a real imager does in the dark (about 2.5 of 255 levels,
               a small CMOS sensor's read noise). -->
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </camera>
        <always_on>true</always_on>
        <update_rate>7.5</update_rate>
        <visualize>false</visualize>
      </sensor>
      <!-- Evaluation only: the simulator's own depth at the left camera, for
           measuring the recovered depth against. Nothing in the perception,
           planning or control path may subscribe to it; a sensor nobody
           subscribes to is not rendered. -->
      <sensor name="evaluation_depth_left" type="depth_camera">
        <gz_frame_id>stereo_tof_link</gz_frame_id>
        <pose>0 0.10 0 0 0 0</pose>
        <camera>
          <horizontal_fov>2.0943951023931953</horizontal_fov>
          <image>
            <width>1280</width>
            <height>960</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>60</far>
          </clip>
          <visibility_mask>218103807</visibility_mask>
        </camera>
        <always_on>true</always_on>
        <update_rate>7.5</update_rate>
        <visualize>false</visualize>
      </sensor>
      <sensor name="tof_up" type="gpu_lidar">
        <gz_frame_id>stereo_tof_link</gz_frame_id>
        <pose>-0.42 0 0.10 0 -1.5707963267948966 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>8</samples>
              <resolution>1</resolution>
              <min_angle>-0.3436116964863836</min_angle>
              <max_angle>0.3436116964863836</max_angle>
            </horizontal>
            <vertical>
              <samples>8</samples>
              <resolution>1</resolution>
              <min_angle>-0.3436116964863836</min_angle>
              <max_angle>0.3436116964863836</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.02</min>
            <max>2.8</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </ray>
        <always_on>true</always_on>
        <update_rate>7.5</update_rate>
        <visualize>false</visualize>
      </sensor>
      <sensor name="tof_down" type="gpu_lidar">
        <gz_frame_id>stereo_tof_link</gz_frame_id>
        <pose>-0.32 0 -0.12 0 1.5707963267948966 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>8</samples>
              <resolution>1</resolution>
              <min_angle>-0.3436116964863836</min_angle>
              <max_angle>0.3436116964863836</max_angle>
            </horizontal>
            <vertical>
              <samples>8</samples>
              <resolution>1</resolution>
              <min_angle>-0.3436116964863836</min_angle>
              <max_angle>0.3436116964863836</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.02</min>
            <max>2.8</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </ray>
        <always_on>true</always_on>
        <update_rate>7.5</update_rate>
        <visualize>false</visualize>
      </sensor>
      <!-- Roadmap item 17 stage 4: the ring of time-of-flight sensors on the
           horizontal, a bumper all round. The sides and the back sit outside
           the propellers' disc, the front under the pair. -->
      <sensor name="tof_front" type="gpu_lidar">
        <gz_frame_id>stereo_tof_link</gz_frame_id>
        <pose>0.02 0 -0.06 0 0 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>8</samples>
              <resolution>1</resolution>
              <min_angle>-0.3436116964863836</min_angle>
              <max_angle>0.3436116964863836</max_angle>
            </horizontal>
            <vertical>
              <samples>8</samples>
              <resolution>1</resolution>
              <min_angle>-0.3436116964863836</min_angle>
              <max_angle>0.3436116964863836</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.02</min>
            <max>2.8</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </ray>
        <always_on>true</always_on>
        <update_rate>7.5</update_rate>
        <visualize>false</visualize>
      </sensor>
      <sensor name="tof_back" type="gpu_lidar">
        <gz_frame_id>stereo_tof_link</gz_frame_id>
        <pose>-0.64 0 0 0 0 3.141592653589793</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>8</samples>
              <resolution>1</resolution>
              <min_angle>-0.3436116964863836</min_angle>
              <max_angle>0.3436116964863836</max_angle>
            </horizontal>
            <vertical>
              <samples>8</samples>
              <resolution>1</resolution>
              <min_angle>-0.3436116964863836</min_angle>
              <max_angle>0.3436116964863836</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.02</min>
            <max>2.8</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </ray>
        <always_on>true</always_on>
        <update_rate>7.5</update_rate>
        <visualize>false</visualize>
      </sensor>
      <sensor name="tof_left" type="gpu_lidar">
        <gz_frame_id>stereo_tof_link</gz_frame_id>
        <pose>-0.32 0.32 0 0 0 1.5707963267948966</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>8</samples>
              <resolution>1</resolution>
              <min_angle>-0.3436116964863836</min_angle>
              <max_angle>0.3436116964863836</max_angle>
            </horizontal>
            <vertical>
              <samples>8</samples>
              <resolution>1</resolution>
              <min_angle>-0.3436116964863836</min_angle>
              <max_angle>0.3436116964863836</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.02</min>
            <max>2.8</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </ray>
        <always_on>true</always_on>
        <update_rate>7.5</update_rate>
        <visualize>false</visualize>
      </sensor>
      <sensor name="tof_right" type="gpu_lidar">
        <gz_frame_id>stereo_tof_link</gz_frame_id>
        <pose>-0.32 -0.32 0 0 0 -1.5707963267948966</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>8</samples>
              <resolution>1</resolution>
              <min_angle>-0.3436116964863836</min_angle>
              <max_angle>0.3436116964863836</max_angle>
            </horizontal>
            <vertical>
              <samples>8</samples>
              <resolution>1</resolution>
              <min_angle>-0.3436116964863836</min_angle>
              <max_angle>0.3436116964863836</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.02</min>
            <max>2.8</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </ray>
        <always_on>true</always_on>
        <update_rate>7.5</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
  </model>
</sdf>
