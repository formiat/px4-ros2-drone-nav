<?xml version="1.0"?>
<!-- The Gazebo window of a recorded flight (roadmap item 20): the 3D scene
     alone. No entity tree, inspector, world control or drawer, so that a
     capture of the window holds nothing but the picture. The debugging GUI is
     Gazebo's default configuration and is not this one. -->
<dialog name="quick_start" show_again="false"/>
<window>
  <width>960</width>
  <height>1080</height>
  <menus>
    <drawer visible="false"/>
    <plugins visible="false"/>
  </menus>
  <dialog_on_exit>false</dialog_on_exit>
</window>

<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <title>3D View</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <engine>ogre2</engine>
  <scene>scene</scene>
  <!-- The location has no light of its own (specification A10): the GUI adds
       none either. -->
  <ambient_light>0 0 0</ambient_light>
  <background_color>0 0 0</background_color>
  <camera_pose>-6 0 6 0 0.5 0</camera_pose>
</plugin>
<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>
<plugin filename="CameraTracking" name="Camera Tracking">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>
